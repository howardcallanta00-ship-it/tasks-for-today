CI_ENVIRONMENT=production
app.baseURL=https://your-app.example.com/
app.appTimezone=Asia/Manila
app.forceGlobalSecureRequests=true
app.sessionDriver=CodeIgniter\Session\Handlers\FileHandler
database.default.hostname=mysql.example.com
database.default.port=3306
database.default.database=tasks_today
database.default.username=tasks_user
database.default.password=replace-with-a-secret
database.default.DBDriver=MySQLi
database.default.encrypt=false
DB_HOST=mysql.example.com
DB_PORT=3306
DB_NAME=tasks_today
DB_USER=tasks_user
DB_PASSWORD=replace-with-a-secret
MIGRATE_ON_START=false
SEED_ON_START=false
app.proxyIPs=
